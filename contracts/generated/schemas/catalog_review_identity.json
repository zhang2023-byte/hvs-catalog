{
  "$defs": {
    "IdentityEntry": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "merge",
            "separate",
            "name",
            "simbad"
          ],
          "title": "Type",
          "type": "string"
        },
        "object": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reading label only; the build ignores it.",
          "title": "Object"
        },
        "groups": {
          "items": {
            "items": {
              "pattern": "^.+v[0-9]+#/stars/(0|[1-9][0-9]*)$",
              "type": "string"
            },
            "type": "array"
          },
          "minItems": 1,
          "title": "Groups",
          "type": "array"
        },
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "main_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SIMBAD object selected for the group.",
          "title": "Main Id"
        },
        "revoke": {
          "default": false,
          "description": "SIMBAD decision that leaves the group without a correspondence.",
          "title": "Revoke",
          "type": "boolean"
        },
        "unresolved": {
          "default": false,
          "title": "Unresolved",
          "type": "boolean"
        },
        "responses": {
          "description": "SIMBAD query key to response hash; bind-review fills an empty map.",
          "patternProperties": {
            "^[0-9a-f]{64}$": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "title": "Responses",
          "type": "object"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/ReviewEvidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "approved": {
          "description": "Approval date followed by the approver or approval record.",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} \\S",
          "title": "Approved",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "groups",
        "reason",
        "evidence",
        "approved"
      ],
      "title": "IdentityEntry",
      "type": "object"
    },
    "ReviewEvidence": {
      "additionalProperties": false,
      "properties": {
        "paper": {
          "description": "Exact versioned paper key in the decision bindings.",
          "title": "Paper",
          "type": "string"
        },
        "location": {
          "minLength": 1,
          "title": "Location",
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        }
      },
      "required": [
        "paper",
        "location"
      ],
      "title": "ReviewEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 3,
      "default": 3,
      "title": "Schema Version",
      "type": "integer"
    },
    "decisions": {
      "items": {
        "$ref": "#/$defs/IdentityEntry"
      },
      "title": "Decisions",
      "type": "array"
    }
  },
  "title": "IdentityReviews",
  "type": "object"
}
