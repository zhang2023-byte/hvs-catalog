{
  "$defs": {
    "ImageEvidence": {
      "additionalProperties": false,
      "description": "A supplied image location without a text transcription.",
      "properties": {
        "location": {
          "description": "Complete image location, such as I:p5-b6.",
          "pattern": "^I:p[1-9][0-9]*-b[0-9]+$",
          "title": "Location",
          "type": "string"
        }
      },
      "required": [
        "location"
      ],
      "title": "ImageEvidence",
      "type": "object"
    },
    "LiteratureContributionType": {
      "additionalProperties": false,
      "description": "The paper's contribution to this star.",
      "properties": {
        "value": {
          "description": "Contribution category. Scientific inclusion rules are separate.",
          "enum": [
            "candidates_found",
            "follow_up"
          ],
          "title": "Value",
          "type": "string"
        },
        "evidence": {
          "description": "Evidence for this contribution type.",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/TextEvidence"
              },
              {
                "$ref": "#/$defs/ImageEvidence"
              }
            ]
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "value",
        "evidence"
      ],
      "title": "LiteratureContributionType",
      "type": "object"
    },
    "LiteratureIdentifier": {
      "additionalProperties": false,
      "description": "One reported identifier and its supporting evidence.",
      "properties": {
        "value": {
          "description": "Star identifier.",
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "evidence": {
          "description": "Evidence for this identifier.",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/TextEvidence"
              },
              {
                "$ref": "#/$defs/ImageEvidence"
              }
            ]
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "value",
        "evidence"
      ],
      "title": "LiteratureIdentifier",
      "type": "object"
    },
    "LiteratureMetadata": {
      "additionalProperties": false,
      "description": "Bibliographic identity of the fixed paper version.",
      "properties": {
        "arxiv_id": {
          "description": "Bare arXiv identifier, without a version suffix.",
          "pattern": "^(?:[0-9]{4}\\.[0-9]{4,5}|[a-zA-Z-]+(?:\\.[A-Z]{2})?/[0-9]{7})$",
          "title": "Arxiv Id",
          "type": "string"
        },
        "version": {
          "description": "arXiv paper version, such as v1; not a format version.",
          "pattern": "^v[1-9][0-9]*$",
          "title": "Version",
          "type": "string"
        },
        "title": {
          "description": "Paper title.",
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "authors": {
          "description": "Paper authors in reported order.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Authors",
          "type": "array"
        }
      },
      "required": [
        "arxiv_id",
        "version",
        "title",
        "authors"
      ],
      "title": "LiteratureMetadata",
      "type": "object"
    },
    "LiteratureQuantity": {
      "additionalProperties": false,
      "description": "Reported values grouped by one existing physical quantity identifier.",
      "properties": {
        "quantity": {
          "description": "Short quantity identifier from the existing science definitions.",
          "enum": [
            "ra",
            "dec",
            "distance",
            "parallax",
            "proper_motion_ra",
            "proper_motion_dec",
            "radial_velocity",
            "galactocentric_radius",
            "galactic_rest_frame_velocity",
            "bound_probability",
            "unbound_probability"
          ],
          "title": "Quantity",
          "type": "string"
        },
        "values": {
          "description": "Reported values, each with its own evidence.",
          "items": {
            "$ref": "#/$defs/LiteratureValue"
          },
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "quantity",
        "values"
      ],
      "title": "LiteratureQuantity",
      "type": "object"
    },
    "LiteratureStar": {
      "additionalProperties": false,
      "description": "This paper's contribution to one star; cross-paper association is separate.",
      "properties": {
        "identifiers": {
          "description": "Identifiers with individual evidence.",
          "items": {
            "$ref": "#/$defs/LiteratureIdentifier"
          },
          "minItems": 1,
          "title": "Identifiers",
          "type": "array"
        },
        "contribution_type": {
          "$ref": "#/$defs/LiteratureContributionType"
        },
        "quantities": {
          "description": "Retained quantities; may be empty if no values are retained.",
          "items": {
            "$ref": "#/$defs/LiteratureQuantity"
          },
          "title": "Quantities",
          "type": "array"
        }
      },
      "required": [
        "identifiers",
        "contribution_type",
        "quantities"
      ],
      "title": "LiteratureStar",
      "type": "object"
    },
    "LiteratureValue": {
      "additionalProperties": false,
      "dependentRequired": {
        "lower_inclusive": [
          "lower_bound"
        ],
        "upper_inclusive": [
          "upper_bound"
        ]
      },
      "description": "One point value, one-sided limit, or pure interval with local evidence.",
      "not": {
        "anyOf": [
          {
            "required": [
              "lower_error"
            ]
          },
          {
            "required": [
              "upper_error"
            ]
          }
        ],
        "required": [
          "error"
        ]
      },
      "oneOf": [
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "lower_bound"
                ]
              },
              {
                "required": [
                  "upper_bound"
                ]
              }
            ]
          },
          "required": [
            "value"
          ]
        },
        {
          "anyOf": [
            {
              "required": [
                "lower_bound"
              ]
            },
            {
              "required": [
                "upper_bound"
              ]
            }
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "value"
                ]
              },
              {
                "required": [
                  "error"
                ]
              },
              {
                "required": [
                  "lower_error"
                ]
              },
              {
                "required": [
                  "upper_error"
                ]
              }
            ]
          }
        }
      ],
      "properties": {
        "value": {
          "description": "Reported point value.",
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "error": {
          "description": "Reported symmetric error.",
          "minLength": 1,
          "title": "Error",
          "type": "string"
        },
        "lower_error": {
          "description": "Reported lower error, preserving its original sign.",
          "minLength": 1,
          "title": "Lower Error",
          "type": "string"
        },
        "upper_error": {
          "description": "Reported upper error, preserving its original sign.",
          "minLength": 1,
          "title": "Upper Error",
          "type": "string"
        },
        "lower_bound": {
          "description": "Reported lower limit or interval endpoint.",
          "minLength": 1,
          "title": "Lower Bound",
          "type": "string"
        },
        "upper_bound": {
          "description": "Reported upper limit or interval endpoint.",
          "minLength": 1,
          "title": "Upper Bound",
          "type": "string"
        },
        "lower_inclusive": {
          "description": "Whether the reported lower bound is included.",
          "title": "Lower Inclusive",
          "type": "boolean"
        },
        "upper_inclusive": {
          "description": "Whether the reported upper bound is included.",
          "title": "Upper Inclusive",
          "type": "boolean"
        },
        "unit": {
          "description": "Unit, when applicable.",
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "condition": {
          "description": "Relevant method, model, reference frame, or statistical meaning.",
          "minLength": 1,
          "title": "Condition",
          "type": "string"
        },
        "evidence": {
          "description": "Evidence for this value and its context.",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/TextEvidence"
              },
              {
                "$ref": "#/$defs/ImageEvidence"
              }
            ]
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "evidence"
      ],
      "title": "LiteratureValue",
      "type": "object"
    },
    "TextEvidence": {
      "additionalProperties": false,
      "description": "An exact excerpt from one supplied text block.",
      "properties": {
        "location": {
          "description": "Complete text location, such as T:p3-b5.",
          "pattern": "^T:p[1-9][0-9]*-b[0-9]+$",
          "title": "Location",
          "type": "string"
        },
        "quote": {
          "description": "Unchanged excerpt from this text block.",
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "location",
        "quote"
      ],
      "title": "TextEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The complete literature_contribution.json scientific document.",
  "properties": {
    "metadata": {
      "$ref": "#/$defs/LiteratureMetadata"
    },
    "stars": {
      "description": "Contributions to individual stars; may be empty.",
      "items": {
        "$ref": "#/$defs/LiteratureStar"
      },
      "title": "Stars",
      "type": "array"
    },
    "notes": {
      "description": "Brief notes about relevant exclusions, suspected errors, ambiguities, and handling decisions with their basis. Put the roster note first. Follow it with quantity notes in saved roster order. Prefix each quantity note with that star's first identifier and ': '. Omit empty notes. Use an empty array when no note is necessary. Notes do not replace field evidence.",
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    }
  },
  "required": [
    "metadata",
    "stars",
    "notes"
  ],
  "title": "LiteratureContribution",
  "type": "object"
}
