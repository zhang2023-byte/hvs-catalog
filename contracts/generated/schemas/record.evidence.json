{
  "$defs": {
    "DataElementDecoder": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "encoding": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Encoding"
        }
      },
      "required": [
        "name",
        "encoding"
      ],
      "title": "DataElementDecoder",
      "type": "object"
    },
    "DataElementLocator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "data_element",
          "title": "Kind",
          "type": "string"
        },
        "selector": {
          "$ref": "#/$defs/DataElementSelector"
        },
        "decoder": {
          "$ref": "#/$defs/DataElementDecoder"
        }
      },
      "required": [
        "kind",
        "selector",
        "decoder"
      ],
      "title": "DataElementLocator",
      "type": "object"
    },
    "DataElementSelector": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "DataElementSelector",
      "type": "object"
    },
    "EvidenceData": {
      "additionalProperties": false,
      "properties": {
        "paper_key": {
          "minLength": 1,
          "title": "Paper Key",
          "type": "string"
        },
        "source_ref": {
          "$ref": "#/$defs/RecordRef"
        },
        "file_id": {
          "minLength": 1,
          "title": "File Id",
          "type": "string"
        },
        "locator": {
          "discriminator": {
            "mapping": {
              "data_element": "#/$defs/DataElementLocator",
              "pdf": "#/$defs/PdfLocator",
              "pdf_image": "#/$defs/PdfImageLocator",
              "table_cell": "#/$defs/TableCellLocator",
              "text": "#/$defs/TextLocator"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/TextLocator"
            },
            {
              "$ref": "#/$defs/TableCellLocator"
            },
            {
              "$ref": "#/$defs/DataElementLocator"
            },
            {
              "$ref": "#/$defs/PdfLocator"
            },
            {
              "$ref": "#/$defs/PdfImageLocator"
            }
          ],
          "title": "Locator"
        },
        "excerpt": {
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        }
      },
      "required": [
        "paper_key",
        "source_ref",
        "file_id",
        "locator",
        "excerpt"
      ],
      "title": "EvidenceData",
      "type": "object"
    },
    "PdfImageLocator": {
      "additionalProperties": false,
      "description": "An image-bound transcription; only the location and image bytes are validated.",
      "properties": {
        "kind": {
          "const": "pdf_image",
          "title": "Kind",
          "type": "string"
        },
        "page": {
          "description": "One-based page in the original PDF.",
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "block_id": {
          "description": "Supplied content block on that page.",
          "minLength": 1,
          "title": "Block Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "page",
        "block_id"
      ],
      "title": "PdfImageLocator",
      "type": "object"
    },
    "PdfLocator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "pdf",
          "title": "Kind",
          "type": "string"
        },
        "page": {
          "description": "One-based page in the original PDF.",
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "block_id": {
          "description": "Supplied content block on that page.",
          "minLength": 1,
          "title": "Block Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "page",
        "block_id"
      ],
      "title": "PdfLocator",
      "type": "object"
    },
    "RecordRef": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "record_id",
        "revision"
      ],
      "title": "RecordRef",
      "type": "object"
    },
    "SchemaTag": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "SchemaTag",
      "type": "object"
    },
    "TableCellLocator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "table_cell",
          "title": "Kind",
          "type": "string"
        },
        "row_key": {
          "additionalProperties": true,
          "minProperties": 1,
          "title": "Row Key",
          "type": "object"
        },
        "column": {
          "minLength": 1,
          "title": "Column",
          "type": "string"
        },
        "row_number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Row Number"
        }
      },
      "required": [
        "kind",
        "row_key",
        "column",
        "row_number"
      ],
      "title": "TableCellLocator",
      "type": "object"
    },
    "TextLocator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "text",
          "title": "Kind",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "start_line",
        "end_line"
      ],
      "title": "TextLocator",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema": {
      "$ref": "#/$defs/SchemaTag"
    },
    "record_id": {
      "minLength": 1,
      "title": "Record Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "execution_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Execution Id"
    },
    "data": {
      "$ref": "#/$defs/EvidenceData"
    }
  },
  "required": [
    "schema",
    "record_id",
    "revision",
    "created_at",
    "execution_id",
    "data"
  ],
  "title": "EvidenceRecord",
  "type": "object"
}
