{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CatalogCounts": {
      "additionalProperties": false,
      "properties": {
        "papers": {
          "minimum": 0,
          "title": "Papers",
          "type": "integer"
        },
        "stars": {
          "minimum": 0,
          "title": "Stars",
          "type": "integer"
        },
        "source_records": {
          "minimum": 0,
          "title": "Source Records",
          "type": "integer"
        },
        "values": {
          "minimum": 0,
          "title": "Values",
          "type": "integer"
        }
      },
      "required": [
        "papers",
        "stars",
        "source_records",
        "values"
      ],
      "title": "CatalogCounts",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": 5,
      "enum": [
        2,
        3,
        4,
        5
      ],
      "title": "Schema Version",
      "type": "integer"
    },
    "data_version": {
      "title": "Data Version",
      "type": "string"
    },
    "counts": {
      "$ref": "#/$defs/CatalogCounts"
    },
    "papers": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "stars": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "rules_version": {
      "enum": [
        1,
        2,
        3,
        4,
        5,
        6
      ],
      "title": "Rules Version",
      "type": "integer"
    },
    "software_version": {
      "title": "Software Version",
      "type": "string"
    },
    "input_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Fingerprint",
      "type": "string"
    },
    "simbad_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Simbad Fingerprint",
      "type": "string"
    },
    "previous_manifest_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Manifest Sha256"
    }
  },
  "required": [
    "data_version",
    "counts",
    "papers",
    "stars",
    "rules_version",
    "software_version",
    "input_fingerprint",
    "simbad_fingerprint"
  ],
  "title": "CatalogRelease",
  "type": "object"
}
