{
  "$defs": {
    "DataElementDecoder": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "encoding": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Encoding"
        }
      },
      "required": [
        "name",
        "encoding"
      ],
      "title": "DataElementDecoder",
      "type": "object"
    },
    "DataElementLocator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "data_element",
          "title": "Kind",
          "type": "string"
        },
        "selector": {
          "$ref": "#/$defs/DataElementSelector"
        },
        "decoder": {
          "$ref": "#/$defs/DataElementDecoder"
        }
      },
      "required": [
        "kind",
        "selector",
        "decoder"
      ],
      "title": "DataElementLocator",
      "type": "object"
    },
    "DataElementSelector": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "DataElementSelector",
      "type": "object"
    },
    "DiscoveryCandidate": {
      "additionalProperties": false,
      "properties": {
        "identifiers": {
          "items": {
            "$ref": "#/$defs/InlineIdentifier"
          },
          "minItems": 1,
          "title": "Identifiers",
          "type": "array"
        }
      },
      "required": [
        "identifiers"
      ],
      "title": "DiscoveryCandidate",
      "type": "object"
    },
    "InlineEvidence": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/InlineSource"
        },
        "parts": {
          "items": {
            "$ref": "#/$defs/InlineEvidencePart"
          },
          "minItems": 0,
          "title": "Parts",
          "type": "array"
        },
        "context": {
          "default": false,
          "title": "Context",
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "parts"
      ],
      "title": "InlineEvidence",
      "type": "object"
    },
    "InlineEvidencePart": {
      "additionalProperties": false,
      "properties": {
        "part": {
          "minLength": 1,
          "title": "Part",
          "type": "string"
        },
        "raw_fragment": {
          "description": "The printed fragment of this component; must equal the filled numeric string of that component.",
          "minLength": 1,
          "title": "Raw Fragment",
          "type": "string"
        }
      },
      "required": [
        "part",
        "raw_fragment"
      ],
      "title": "InlineEvidencePart",
      "type": "object"
    },
    "InlineIdentifier": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/InlineEvidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "value",
        "evidence"
      ],
      "title": "InlineIdentifier",
      "type": "object"
    },
    "InlineQuestion": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "inclusion",
            "identity",
            "author_assessment",
            "numeric_conflict",
            "quantity_attribution",
            "interpretation"
          ],
          "title": "Category",
          "type": "string"
        },
        "prompt": {
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/InlineEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "gap_ids": {
          "items": {
            "type": "string"
          },
          "title": "Gap Ids",
          "type": "array"
        }
      },
      "required": [
        "category",
        "prompt"
      ],
      "title": "InlineQuestion",
      "type": "object"
    },
    "InlineSource": {
      "additionalProperties": false,
      "properties": {
        "file_id": {
          "minLength": 1,
          "title": "File Id",
          "type": "string"
        },
        "locator": {
          "discriminator": {
            "mapping": {
              "data_element": "#/$defs/DataElementLocator",
              "table_cell": "#/$defs/TableCellLocator",
              "text": "#/$defs/TextLocator"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/TextLocator"
            },
            {
              "$ref": "#/$defs/TableCellLocator"
            },
            {
              "$ref": "#/$defs/DataElementLocator"
            }
          ],
          "title": "Locator"
        },
        "excerpt": {
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        }
      },
      "required": [
        "file_id",
        "locator",
        "excerpt"
      ],
      "title": "InlineSource",
      "type": "object"
    },
    "RosterCoverageSubmission": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "not_checked",
            "partial",
            "complete"
          ],
          "title": "State",
          "type": "string"
        },
        "checked_file_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 0,
          "title": "Checked File Ids",
          "type": "array"
        },
        "gap_ids": {
          "items": {
            "type": "string"
          },
          "title": "Gap Ids",
          "type": "array"
        }
      },
      "required": [
        "state",
        "checked_file_ids"
      ],
      "title": "RosterCoverageSubmission",
      "type": "object"
    },
    "TableCellLocator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "table_cell",
          "title": "Kind",
          "type": "string"
        },
        "row_key": {
          "additionalProperties": true,
          "minProperties": 1,
          "title": "Row Key",
          "type": "object"
        },
        "column": {
          "minLength": 1,
          "title": "Column",
          "type": "string"
        },
        "row_number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Row Number"
        }
      },
      "required": [
        "kind",
        "row_key",
        "column",
        "row_number"
      ],
      "title": "TableCellLocator",
      "type": "object"
    },
    "TextLocator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "text",
          "title": "Kind",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "start_line",
        "end_line"
      ],
      "title": "TextLocator",
      "type": "object"
    },
    "UnresolvedGroupSubmission": {
      "additionalProperties": false,
      "properties": {
        "original_range": {
          "minLength": 1,
          "title": "Original Range",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/InlineEvidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "member_identifier_values": {
          "items": {
            "type": "string"
          },
          "title": "Member Identifier Values",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "original_range",
        "evidence",
        "reason"
      ],
      "title": "UnresolvedGroupSubmission",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Provisional inventory; scientific fields reuse the roster/evidence definitions.",
  "properties": {
    "coverage": {
      "$ref": "#/$defs/RosterCoverageSubmission"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/DiscoveryCandidate"
      },
      "title": "Candidates",
      "type": "array"
    },
    "unresolved_groups": {
      "items": {
        "$ref": "#/$defs/UnresolvedGroupSubmission"
      },
      "title": "Unresolved Groups",
      "type": "array"
    },
    "questions": {
      "items": {
        "$ref": "#/$defs/InlineQuestion"
      },
      "title": "Questions",
      "type": "array"
    }
  },
  "required": [
    "coverage",
    "candidates",
    "unresolved_groups",
    "questions"
  ],
  "title": "DiscoverySubmission",
  "type": "object"
}
