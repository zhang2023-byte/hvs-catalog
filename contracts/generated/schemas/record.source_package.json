{
  "$defs": {
    "ArxivOrigin": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "arxiv",
          "title": "Kind",
          "type": "string"
        },
        "arxiv_id": {
          "minLength": 1,
          "title": "Arxiv Id",
          "type": "string"
        },
        "retrieval": {
          "description": "How and when the source package was retrieved, e.g. the download basis.",
          "minLength": 1,
          "title": "Retrieval",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "arxiv_id",
        "retrieval"
      ],
      "title": "ArxivOrigin",
      "type": "object"
    },
    "LocalPdfOrigin": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "local_pdf",
          "title": "Kind",
          "type": "string"
        },
        "provenance": {
          "minLength": 1,
          "title": "Provenance",
          "type": "string"
        },
        "doi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doi"
        }
      },
      "required": [
        "kind",
        "provenance"
      ],
      "title": "LocalPdfOrigin",
      "type": "object"
    },
    "SchemaTag": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "SchemaTag",
      "type": "object"
    },
    "SourceFile": {
      "additionalProperties": false,
      "properties": {
        "file_id": {
          "minLength": 1,
          "title": "File Id",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "read_state": {
          "enum": [
            "ready",
            "unparsed",
            "unreadable"
          ],
          "title": "Read State",
          "type": "string"
        },
        "derived_from": {
          "items": {
            "type": "string"
          },
          "title": "Derived From",
          "type": "array"
        }
      },
      "required": [
        "file_id",
        "path",
        "sha256",
        "media_type",
        "role",
        "read_state",
        "derived_from"
      ],
      "title": "SourceFile",
      "type": "object"
    },
    "SourcePackageData": {
      "additionalProperties": false,
      "properties": {
        "paper_key": {
          "minLength": 1,
          "title": "Paper Key",
          "type": "string"
        },
        "origin": {
          "discriminator": {
            "mapping": {
              "arxiv": "#/$defs/ArxivOrigin",
              "local_pdf": "#/$defs/LocalPdfOrigin",
              "synthetic": "#/$defs/SyntheticOrigin"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/SyntheticOrigin"
            },
            {
              "$ref": "#/$defs/ArxivOrigin"
            },
            {
              "$ref": "#/$defs/LocalPdfOrigin"
            }
          ],
          "title": "Origin"
        },
        "source_version": {
          "minLength": 1,
          "title": "Source Version",
          "type": "string"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/SourceFile"
          },
          "minItems": 0,
          "title": "Files",
          "type": "array"
        },
        "preparation_issues": {
          "items": {
            "type": "string"
          },
          "title": "Preparation Issues",
          "type": "array"
        }
      },
      "required": [
        "paper_key",
        "origin",
        "source_version",
        "files"
      ],
      "title": "SourcePackageData",
      "type": "object"
    },
    "SyntheticOrigin": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "synthetic",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "SyntheticOrigin",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema": {
      "$ref": "#/$defs/SchemaTag"
    },
    "record_id": {
      "minLength": 1,
      "title": "Record Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "execution_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Execution Id"
    },
    "data": {
      "$ref": "#/$defs/SourcePackageData"
    }
  },
  "required": [
    "schema",
    "record_id",
    "revision",
    "created_at",
    "execution_id",
    "data"
  ],
  "title": "SourcePackageRecord",
  "type": "object"
}
