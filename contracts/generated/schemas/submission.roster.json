{
  "$defs": {
    "AuthorErrorSubmission": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "raw_values": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Raw Values",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/InlineEvidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "reason",
        "raw_values",
        "evidence"
      ],
      "title": "AuthorErrorSubmission",
      "type": "object"
    },
    "ConditionalAssessmentSubmission": {
      "additionalProperties": false,
      "properties": {
        "condition": {
          "minLength": 1,
          "title": "Condition",
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/InlineEvidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "condition",
        "statement",
        "evidence"
      ],
      "title": "ConditionalAssessmentSubmission",
      "type": "object"
    },
    "InlineEvidence": {
      "type": "object",
      "properties": {
        "location": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "location",
        "quote"
      ],
      "additionalProperties": false
    },
    "InlineIdentifier": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/InlineEvidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "value",
        "evidence"
      ],
      "title": "InlineIdentifier",
      "type": "object"
    },
    "RosterCoverageSubmission": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "not_checked",
            "partial",
            "complete"
          ],
          "title": "State",
          "type": "string"
        },
        "checked_file_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 0,
          "title": "Checked File Ids",
          "type": "array"
        },
        "gap_ids": {
          "items": {
            "type": "string"
          },
          "title": "Gap Ids",
          "type": "array"
        }
      },
      "required": [
        "state",
        "checked_file_ids"
      ],
      "title": "RosterCoverageSubmission",
      "type": "object"
    },
    "RosterEntrySubmission": {
      "additionalProperties": false,
      "properties": {
        "identifiers": {
          "items": {
            "$ref": "#/$defs/InlineIdentifier"
          },
          "minItems": 1,
          "title": "Identifiers",
          "type": "array"
        },
        "disposition": {
          "enum": [
            "included",
            "excluded",
            "pending"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/InlineEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "gap_ids": {
          "items": {
            "type": "string"
          },
          "title": "Gap Ids",
          "type": "array"
        },
        "author_errors": {
          "items": {
            "$ref": "#/$defs/AuthorErrorSubmission"
          },
          "title": "Author Errors",
          "type": "array"
        },
        "summary": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "summary_evidence": {
          "items": {
            "$ref": "#/$defs/InlineEvidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "contribution_type": {
          "enum": [
            "candidates_found",
            "follow_up"
          ],
          "title": "Value",
          "type": "string"
        },
        "type_evidence": {
          "items": {
            "$ref": "#/$defs/InlineEvidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "boundness": {
          "anyOf": [
            {
              "enum": [
                "no_overall_conclusion",
                "unbound",
                "possibly_unbound",
                "possibly_bound",
                "bound"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "boundness_evidence": {
          "items": {
            "$ref": "#/$defs/InlineEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "boundness_author_errors": {
          "items": {
            "$ref": "#/$defs/AuthorErrorSubmission"
          },
          "title": "Author Errors",
          "type": "array"
        },
        "boundness_gap_ids": {
          "items": {
            "type": "string"
          },
          "title": "Gap Ids",
          "type": "array"
        },
        "conditional_assessments": {
          "items": {
            "$ref": "#/$defs/ConditionalAssessmentSubmission"
          },
          "title": "Conditional Assessments",
          "type": "array"
        }
      },
      "required": [
        "identifiers",
        "disposition"
      ],
      "title": "RosterEntrySubmission",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "included"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "required": [
              "summary",
              "summary_evidence",
              "contribution_type",
              "type_evidence",
              "boundness",
              "conditional_assessments"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "summary"
                  ]
                },
                {
                  "required": [
                    "summary_evidence"
                  ]
                },
                {
                  "required": [
                    "contribution_type"
                  ]
                },
                {
                  "required": [
                    "type_evidence"
                  ]
                },
                {
                  "required": [
                    "boundness"
                  ]
                },
                {
                  "required": [
                    "boundness_evidence"
                  ]
                },
                {
                  "required": [
                    "boundness_author_errors"
                  ]
                },
                {
                  "required": [
                    "boundness_gap_ids"
                  ]
                },
                {
                  "required": [
                    "conditional_assessments"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "enum": [
                  "included",
                  "excluded"
                ]
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "required": [
              "evidence"
            ],
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "boundness": {
                "enum": [
                  "unbound",
                  "possibly_unbound",
                  "possibly_bound",
                  "bound"
                ]
              }
            },
            "required": [
              "boundness"
            ]
          },
          "then": {
            "required": [
              "boundness_evidence"
            ],
            "properties": {
              "boundness_evidence": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "UnresolvedGroupSubmission": {
      "additionalProperties": false,
      "properties": {
        "original_range": {
          "minLength": 1,
          "title": "Original Range",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/InlineEvidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "member_identifier_values": {
          "items": {
            "type": "string"
          },
          "title": "Member Identifier Values",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "original_range",
        "evidence",
        "reason"
      ],
      "title": "UnresolvedGroupSubmission",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "coverage": {
      "$ref": "#/$defs/RosterCoverageSubmission"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/RosterEntrySubmission"
      },
      "title": "Entries",
      "type": "array"
    },
    "unresolved_groups": {
      "items": {
        "$ref": "#/$defs/UnresolvedGroupSubmission"
      },
      "title": "Unresolved Groups",
      "type": "array"
    },
    "model_judgments": {
      "description": "Brief chosen interpretations with their supporting original evidence.",
      "items": {
        "type": "string"
      },
      "title": "Model Judgments",
      "type": "array"
    }
  },
  "required": [
    "coverage",
    "entries",
    "unresolved_groups"
  ],
  "title": "RosterSubmission",
  "type": "object"
}
