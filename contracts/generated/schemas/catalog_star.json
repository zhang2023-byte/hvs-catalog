        },
        "additional_fields": {
          "additionalProperties": {
            "additionalProperties": true,
            "type": "object"
          },
          "description": "Other nonempty returned fields; unfamiliar scientific columns are never discarded.",
          "title": "Additional Fields",
          "type": "object"
        }
      },
      "required": [
        "main_id"
      ],
      "title": "SimbadScience",
      "type": "object"
