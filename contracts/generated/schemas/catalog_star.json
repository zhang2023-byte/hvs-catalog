{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CatalogContributionType": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "description": "Contribution category. Scientific inclusion rules are separate.",
          "enum": [
            "candidates_found",
            "follow_up"
          ],
          "title": "Value",
          "type": "string"
        },
        "evidence": {
          "description": "Evidence for this contribution type.",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/TextEvidence"
              },
              {
                "$ref": "#/$defs/ImageEvidence"
              }
            ]
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "source": {
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "value",
        "evidence",
        "source"
      ],
      "title": "CatalogContributionType",
      "type": "object"
    },
    "CatalogIdentifier": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "description": "Star identifier.",
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "evidence": {
          "description": "Evidence for this identifier.",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/TextEvidence"
              },
              {
                "$ref": "#/$defs/ImageEvidence"
              }
            ]
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "source": {
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "value",
        "evidence",
        "source"
      ],
      "title": "CatalogIdentifier",
      "type": "object"
    },
    "CatalogQuantity": {
      "additionalProperties": false,
      "properties": {
        "quantity": {
          "enum": [
            "ra",
            "dec",
            "distance",
            "parallax",
            "proper_motion_ra",
            "proper_motion_dec",
            "radial_velocity",
            "galactocentric_radius",
            "galactic_rest_frame_velocity",
            "bound_probability",
            "unbound_probability"
          ],
          "title": "Quantity",
          "type": "string"
        },
        "values": {
          "items": {
            "$ref": "#/$defs/CatalogValue"
          },
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "quantity",
        "values"
      ],
      "title": "CatalogQuantity",
      "type": "object"
    },
    "CatalogValue": {
      "additionalProperties": false,
      "dependentRequired": {
        "lower_inclusive": [
          "lower_bound"
        ],
        "upper_inclusive": [
          "upper_bound"
        ]
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "lower_error"
            ]
          },
          {
            "required": [
              "upper_error"
            ]
          }
        ],
        "required": [
          "error"
        ]
      },
      "oneOf": [
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "lower_bound"
                ]
              },
              {
                "required": [
                  "upper_bound"
                ]
              }
            ]
          },
          "required": [
            "value"
          ]
        },
        {
          "anyOf": [
            {
              "required": [
                "lower_bound"
              ]
            },
            {
              "required": [
                "upper_bound"
              ]
            }
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "value"
                ]
              },
              {
                "required": [
                  "error"
                ]
              },
              {
                "required": [
                  "lower_error"
                ]
              },
              {
                "required": [
                  "upper_error"
                ]
              }
            ]
          }
        }
      ],
      "properties": {
        "value": {
          "description": "Reported point value.",
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "error": {
          "description": "Reported symmetric error.",
          "minLength": 1,
          "title": "Error",
          "type": "string"
        },
        "lower_error": {
          "description": "Reported lower error, preserving its original sign.",
          "minLength": 1,
          "title": "Lower Error",
          "type": "string"
        },
        "upper_error": {
          "description": "Reported upper error, preserving its original sign.",
          "minLength": 1,
          "title": "Upper Error",
          "type": "string"
        },
        "lower_bound": {
          "description": "Reported lower limit or interval endpoint.",
          "minLength": 1,
          "title": "Lower Bound",
          "type": "string"
        },
        "upper_bound": {
          "description": "Reported upper limit or interval endpoint.",
          "minLength": 1,
          "title": "Upper Bound",
          "type": "string"
        },
        "lower_inclusive": {
          "description": "Whether the reported lower bound is included.",
          "title": "Lower Inclusive",
          "type": "boolean"
        },
        "upper_inclusive": {
          "description": "Whether the reported upper bound is included.",
          "title": "Upper Inclusive",
          "type": "boolean"
        },
        "unit": {
          "description": "Unit, when applicable.",
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "condition": {
          "description": "Relevant method, model, reference frame, or statistical meaning.",
          "minLength": 1,
          "title": "Condition",
          "type": "string"
        },
        "evidence": {
          "description": "Evidence for this value and its context.",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/TextEvidence"
              },
              {
                "$ref": "#/$defs/ImageEvidence"
              }
            ]
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "source": {
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "evidence",
        "source"
      ],
      "title": "CatalogValue",
      "type": "object"
    },
    "ImageEvidence": {
      "additionalProperties": false,
      "description": "A supplied image location without a text transcription.",
      "properties": {
        "location": {
          "description": "Complete image location, such as I:p5-b6.",
          "pattern": "^I:p[1-9][0-9]*-b[0-9]+$",
          "title": "Location",
          "type": "string"
        }
      },
      "required": [
        "location"
      ],
      "title": "ImageEvidence",
      "type": "object"
    },
    "JsonValue": {},
    "SimbadCoordinateMatch": {
      "additionalProperties": false,
      "properties": {
        "source_record": {
          "title": "Source Record",
          "type": "string"
        },
        "separation_arcsec": {
          "title": "Separation Arcsec",
          "type": "number"
        },
        "radius_arcsec": {
          "title": "Radius Arcsec",
          "type": "number"
        },
        "candidate_count": {
          "anyOf": [
            {
              "minimum": 2,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Present when more than one candidate was considered.",
          "title": "Candidate Count"
        },
        "assumed_frame": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assumed Frame"
        },
        "historical": {
          "default": false,
          "title": "Historical",
          "type": "boolean"
        }
      },
      "required": [
        "source_record",
        "separation_arcsec",
        "radius_arcsec"
      ],
      "title": "SimbadCoordinateMatch",
      "type": "object"
    },
    "SimbadCoordinates": {
      "additionalProperties": false,
      "properties": {
        "ra": {
          "anyOf": [
            {
              "$ref": "#/$defs/SimbadValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dec": {
          "anyOf": [
            {
              "$ref": "#/$defs/SimbadValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "frame": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame"
        },
        "equinox": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Equinox"
        },
        "error_ellipse": {
          "anyOf": [
            {
              "$ref": "#/$defs/SimbadEllipse"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "quality": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality"
        },
        "bibcode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bibcode"
        },
        "wavelength": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wavelength"
        }
      },
      "title": "SimbadCoordinates",
      "type": "object"
    },
    "SimbadEllipse": {
      "additionalProperties": false,
      "properties": {
        "major": {
          "anyOf": [
            {
              "$ref": "#/$defs/SimbadValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "minor": {
          "anyOf": [
            {
              "$ref": "#/$defs/SimbadValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "angle": {
          "anyOf": [
            {
              "$ref": "#/$defs/SimbadValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "SimbadEllipse",
      "type": "object"
    },
    "SimbadMatchSummary": {
      "additionalProperties": false,
      "properties": {
        "identifiers": {
          "items": {
            "type": "string"
          },
          "title": "Identifiers",
          "type": "array"
        },
        "coordinates": {
          "items": {
            "$ref": "#/$defs/SimbadCoordinateMatch"
          },
          "title": "Coordinates",
          "type": "array"
        },
        "candidates": {
          "description": "Distinct object names only for unresolved identity.",
          "items": {
            "type": "string"
          },
          "title": "Candidates",
          "type": "array"
        }
      },
      "title": "SimbadMatchSummary",
      "type": "object"
    },
    "SimbadMeasurement": {
      "additionalProperties": false,
