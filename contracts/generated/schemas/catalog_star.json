          "title": "System"
        },
        "additional_fields": {
          "additionalProperties": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Additional Fields",
          "type": "object"
        }
      },
      "required": [
        "band"
      ],
      "title": "SimbadPhotometry",
      "type": "object"
    },
