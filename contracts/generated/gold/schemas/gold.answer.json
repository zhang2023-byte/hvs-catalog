{
  "$defs": {
    "CompactBoundness": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/GoldEvidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "value"
      ],
      "title": "CompactBoundness",
      "type": "object"
    },
    "CompactClaim": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/GoldEvidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "value"
      ],
      "title": "CompactClaim",
      "type": "object"
    },
    "CompactConflict": {
      "additionalProperties": false,
      "properties": {
        "conflict_id": {
          "minLength": 1,
          "title": "Conflict Id",
          "type": "string"
        },
        "quantity": {
          "minLength": 1,
          "title": "Quantity",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/CompactClaim"
        },
        "alternatives": {
          "items": {
            "$ref": "#/$defs/CompactValue"
          },
          "title": "Alternatives",
          "type": "array"
        }
      },
      "required": [
        "conflict_id",
        "quantity",
        "reason"
      ],
      "title": "CompactConflict",
      "type": "object"
    },
    "CompactContribution": {
      "additionalProperties": false,
      "properties": {
        "contribution_id": {
          "pattern": "^\\d{4}\\.\\d{4,5}:cand\\d{2,}$",
          "title": "Contribution Id",
          "type": "string"
        },
        "identifiers": {
          "items": {
            "$ref": "#/$defs/CompactIdentifier"
          },
          "minItems": 1,
          "title": "Identifiers",
          "type": "array"
        },
        "contribution_type": {
          "$ref": "#/$defs/CompactClaim"
        },
        "contribution_summary": {
          "$ref": "#/$defs/CompactClaim"
        },
        "paper_boundness": {
          "$ref": "#/$defs/CompactBoundness"
        },
        "quantities": {
          "items": {
            "$ref": "#/$defs/CompactQuantityGroup"
          },
          "title": "Quantities",
          "type": "array"
        },
        "quantity_conflicts": {
          "items": {
            "$ref": "#/$defs/CompactConflict"
          },
          "title": "Quantity Conflicts",
          "type": "array"
        }
      },
      "required": [
        "contribution_id",
        "identifiers",
        "contribution_type",
        "contribution_summary",
        "paper_boundness"
      ],
      "title": "CompactContribution",
      "type": "object"
    },
    "CompactCoverage": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "enum": [
            "complete",
            "partial"
          ],
          "title": "Value",
          "type": "string"
        },
        "limitations": {
          "items": {
            "$ref": "#/$defs/CompactScopeLimitation"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "value"
      ],
      "title": "CompactCoverage",
      "type": "object"
    },
    "CompactErrorComponent": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "lower_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower Error"
        },
        "upper_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper Error"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/GoldEvidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "name",
        "evidence"
      ],
      "title": "CompactErrorComponent",
      "type": "object"
    },
    "CompactExclusion": {
      "additionalProperties": false,
      "properties": {
        "exclusion_id": {
          "minLength": 1,
          "title": "Exclusion Id",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/CompactClaim"
        }
      },
      "required": [
        "exclusion_id",
        "reason"
      ],
      "title": "CompactExclusion",
      "type": "object"
    },
    "CompactIdentifier": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/GoldEvidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "value"
      ],
      "title": "CompactIdentifier",
      "type": "object"
    },
    "CompactQuantityGroup": {
      "additionalProperties": false,
      "properties": {
        "quantity": {
          "title": "Quantity",
          "type": "string"
        },
        "values": {
          "items": {
            "$ref": "#/$defs/CompactValue"
          },
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "quantity",
        "values"
      ],
      "title": "CompactQuantityGroup",
      "type": "object"
    },
    "CompactScopeLimitation": {
      "additionalProperties": false,
      "properties": {
        "subject": {
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/GoldEvidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "subject",
        "value"
      ],
      "title": "CompactScopeLimitation",
      "type": "object"
    },
    "CompactUnresolved": {
      "additionalProperties": false,
      "properties": {
        "subject": {
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/GoldEvidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "subject",
        "value"
      ],
      "title": "CompactUnresolved",
      "type": "object"
    },
    "CompactValue": {
      "additionalProperties": false,
      "description": "The v1 numeric contract, with value first and its PDF evidence last.",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "lower_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower Error"
        },
        "upper_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper Error"
        },
        "limit_kind": {
          "default": "none",
          "enum": [
            "none",
            "lower_limit",
            "upper_limit",
            "range"
          ],
          "title": "Limit Kind",
          "type": "string"
        },
        "range_lower": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Range Lower"
        },
        "range_upper": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Range Upper"
        },
        "coordinate_format": {
          "anyOf": [
            {
              "enum": [
                "decimal_degrees",
                "sexagesimal_hms",
                "sexagesimal_dms",
                "sexagesimal_colon"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coordinate Format"
        },
        "condition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition"
        },
        "interval_kind": {
          "anyOf": [
            {
              "enum": [
                "ordinary_range",
                "prior_support",
                "confidence",
                "credible",
                "statistical_interval",
                "unspecified"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval Kind"
        },
        "coverage": {
          "anyOf": [
            {
              "$ref": "#/$defs/GoldProbability"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "lower_quantile": {
          "anyOf": [
            {
              "$ref": "#/$defs/GoldProbability"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "upper_quantile": {
          "anyOf": [
            {
              "$ref": "#/$defs/GoldProbability"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "error_components": {
          "items": {
            "$ref": "#/$defs/CompactErrorComponent"
          },
          "title": "Error Components",
          "type": "array"
        },
        "representation": {
          "anyOf": [
            {
              "enum": [
                "linear",
                "log10",
                "distance_modulus"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Representation"
        },
        "source": {
          "enum": [
            "this_paper",
            "prior_work",
            "unclear"
          ],
          "title": "Source",
          "type": "string"
        },
        "source_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Note"
        },
        "context_evidence": {
          "items": {
            "$ref": "#/$defs/GoldEvidence"
          },
          "title": "Context Evidence",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/GoldEvidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "value",
        "source"
      ],
      "title": "CompactValue",
      "type": "object"
    },
    "GoldEvidence": {
      "additionalProperties": false,
      "description": "专家在固定 PDF 中看到该内容的位置。\n\n``location`` 逐字保留原位置说明（页、表、节或对象行）；``page`` 是\nPDF 文件页序号（从 1 起），与书页上印刷的页码不同，只在明确知道时\n填写，不从位置文本猜测；``quote`` 是可选引文，空字符串表示未提供。",
      "properties": {
        "file_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File Id"
        },
        "location": {
          "minLength": 1,
          "title": "Location",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "quote": {
          "default": "",
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "location"
      ],
      "title": "GoldEvidence",
      "type": "object"
    },
    "GoldProbability": {
      "additionalProperties": false,
      "description": "显式印出的覆盖概率或分位点；换算由消费方负责，不写回记录。",
      "properties": {
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "unit": {
          "enum": [
            "fraction",
            "%"
          ],
          "title": "Unit",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/GoldEvidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "value",
        "unit",
        "evidence"
      ],
      "title": "GoldProbability",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "arxiv_id": {
      "pattern": "^\\d{4}\\.\\d{4,5}$",
      "title": "Arxiv Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "contributions_found",
        "no_contributions"
      ],
      "title": "Status",
      "type": "string"
    },
    "coverage": {
      "$ref": "#/$defs/CompactCoverage"
    },
    "contributions": {
      "items": {
        "$ref": "#/$defs/CompactContribution"
      },
      "title": "Contributions",
      "type": "array"
    },
    "reviewed_exclusions": {
      "items": {
        "$ref": "#/$defs/CompactExclusion"
      },
      "title": "Reviewed Exclusions",
      "type": "array"
    },
    "unresolved": {
      "items": {
        "$ref": "#/$defs/CompactUnresolved"
      },
      "title": "Unresolved",
      "type": "array"
    }
  },
  "required": [
    "arxiv_id",
    "status",
    "coverage",
    "contributions"
  ],
  "title": "CompactGoldAnswer",
  "type": "object"
}
