{
  "$defs": {
    "GoldActor": {
      "additionalProperties": false,
      "description": "Declared maker identity; AI identity never constitutes expert approval.",
      "properties": {
        "actor_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Actor Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "human",
            "ai"
          ],
          "title": "Kind",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        }
      },
      "required": [
        "actor_id",
        "kind"
      ],
      "title": "GoldActor",
      "type": "object"
    },
    "GoldBoundness": {
      "additionalProperties": false,
      "description": "作者总体状态：新词表状态待定时为 null，旧状态原样保留供核查。",
      "properties": {
        "status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "legacy_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Legacy Status"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/GoldEvidence"
          },
          "minItems": 0,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "evidence"
      ],
      "title": "GoldBoundness",
      "type": "object"
    },
    "GoldConflict": {
      "additionalProperties": false,
      "description": "未决的竞争证据；双方完整数值结构可选，缺失时由检查报告待补。",
      "properties": {
        "conflict_id": {
          "minLength": 1,
          "title": "Conflict Id",
          "type": "string"
        },
        "quantity": {
          "minLength": 1,
          "title": "Quantity",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/GoldEvidence"
          },
          "minItems": 2,
          "title": "Evidence",
          "type": "array"
        },
        "alternatives": {
          "items": {
            "$ref": "#/$defs/GoldValue"
          },
          "minItems": 0,
          "title": "Alternatives",
          "type": "array"
        }
      },
      "required": [
        "conflict_id",
        "quantity",
        "reason",
        "evidence",
        "alternatives"
      ],
      "title": "GoldConflict",
      "type": "object"
    },
    "GoldContribution": {
      "additionalProperties": false,
      "properties": {
        "contribution_id": {
          "minLength": 1,
          "title": "Contribution Id",
          "type": "string"
        },
        "legacy_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Legacy Index"
        },
        "identifiers": {
          "items": {
            "$ref": "#/$defs/GoldIdentifier"
          },
          "minItems": 1,
          "title": "Identifiers",
          "type": "array"
        },
        "contribution_type": {
          "enum": [
            "candidates_found",
            "follow_up"
          ],
          "title": "Contribution Type",
          "type": "string"
        },
        "contribution_summary": {
          "minLength": 1,
          "title": "Contribution Summary",
          "type": "string"
        },
        "contribution_evidence": {
          "items": {
            "$ref": "#/$defs/GoldEvidence"
          },
          "minItems": 0,
          "title": "Contribution Evidence",
          "type": "array"
        },
        "paper_boundness": {
          "$ref": "#/$defs/GoldBoundness"
        },
        "quantities": {
          "items": {
            "$ref": "#/$defs/GoldQuantityGroup"
          },
          "minItems": 0,
          "title": "Quantities",
          "type": "array"
        },
        "quantity_conflicts": {
          "items": {
            "$ref": "#/$defs/GoldConflict"
          },
          "minItems": 0,
          "title": "Quantity Conflicts",
          "type": "array"
        }
      },
      "required": [
        "contribution_id",
        "identifiers",
        "contribution_type",
        "contribution_summary",
        "contribution_evidence",
        "paper_boundness",
        "quantities",
        "quantity_conflicts"
      ],
      "title": "GoldContribution",
      "type": "object"
    },
    "GoldErrorComponent": {
      "additionalProperties": false,
      "description": "一个具名的原始误差分量；不推算总误差。\n\n误差形式与共同记录 ``ErrorComponent`` 一致：单侧非对称误差允许，\n对称与非对称不能混用，至少提供一个误差数值。",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error"
        },
        "lower_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lower Error"
        },
        "upper_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Upper Error"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/GoldEvidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "name",
        "error",
        "lower_error",
        "upper_error",
        "evidence"
      ],
      "title": "GoldErrorComponent",
      "type": "object"
    },
    "GoldEvidence": {
      "additionalProperties": false,
      "description": "专家在固定 PDF 中看到该内容的位置。\n\n``location`` 逐字保留原位置说明（页、表、节或对象行）；``page`` 是\nPDF 文件页序号（从 1 起），与书页上印刷的页码不同，只在明确知道时\n填写，不从位置文本猜测；``quote`` 是可选引文，空字符串表示未提供。",
      "properties": {
        "file_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File Id"
        },
        "location": {
          "minLength": 1,
          "title": "Location",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "quote": {
          "default": "",
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "location"
      ],
      "title": "GoldEvidence",
      "type": "object"
    },
    "GoldExclusion": {
      "additionalProperties": false,
      "description": "论文层面的排除记录；旧结构没有独立对象标识，作为待对应项目保留。",
      "properties": {
        "exclusion_id": {
          "minLength": 1,
          "title": "Exclusion Id",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/GoldEvidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "exclusion_id",
        "reason",
        "evidence"
      ],
      "title": "GoldExclusion",
      "type": "object"
    },
    "GoldHuman": {
      "additionalProperties": false,
      "description": "Declared human expert identity; no authentication is implied.",
      "properties": {
        "actor_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Actor Id",
          "type": "string"
        },
        "kind": {
          "const": "human",
          "default": "human",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "actor_id"
      ],
      "title": "GoldHuman",
      "type": "object"
    },
    "GoldIdentifier": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/GoldEvidence"
          },
          "minItems": 0,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "value",
        "evidence"
      ],
      "title": "GoldIdentifier",
      "type": "object"
    },
    "GoldLatexSource": {
      "additionalProperties": false,
      "description": "A fixed source file or archive under the explicitly supplied material root.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "sha256",
        "version"
      ],
      "title": "GoldLatexSource",
      "type": "object"
    },
    "GoldLegacySource": {
      "additionalProperties": false,
      "description": "迁移来源：旧输入的原始标注信息，逐字保留，不构成新批准。",
      "properties": {
        "schema_name": {
          "minLength": 1,
          "title": "Schema Name",
          "type": "string"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "file_name": {
          "minLength": 1,
          "title": "File Name",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "arxiv_id": {
          "minLength": 1,
          "title": "Arxiv Id",
          "type": "string"
        },
        "annotator": {
          "minLength": 1,
          "title": "Annotator",
          "type": "string"
        },
        "annotated_at": {
          "minLength": 1,
          "title": "Annotated At",
          "type": "string"
        },
        "guideline_version": {
          "minLength": 1,
          "title": "Guideline Version",
          "type": "string"
        },
        "annotation_process": {
          "additionalProperties": true,
          "title": "Annotation Process",
          "type": "object"
        },
        "canary": {
          "default": "",
          "title": "Canary",
          "type": "string"
        }
      },
      "required": [
        "schema_name",
        "schema_version",
        "file_name",
        "sha256",
        "arxiv_id",
        "annotator",
        "annotated_at",
        "guideline_version"
      ],
      "title": "GoldLegacySource",
      "type": "object"
    },
    "GoldMaterialCorrespondence": {
      "additionalProperties": false,
      "description": "Expert-declared PDF/source correspondence; hashing does not prove equivalence.",
      "properties": {
        "status": {
          "default": "pending",
          "enum": [
            "pending",
            "checked"
          ],
          "title": "Status",
          "type": "string"
        },
        "pdf_file_ids": {
          "items": {
            "type": "string"
          },
          "title": "Pdf File Ids",
          "type": "array"
        },
        "latex": {
          "anyOf": [
            {
              "$ref": "#/$defs/GoldLatexSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "checked_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/GoldHuman"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "checked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checked At"
        },
        "basis": {
          "default": "",
          "title": "Basis",
          "type": "string"
        },
        "differences": {
          "items": {
            "type": "string"
          },
          "title": "Differences",
          "type": "array"
        }
      },
      "title": "GoldMaterialCorrespondence",
      "type": "object"
    },
    "GoldOriginalExpert": {
      "additionalProperties": false,
      "description": "Historical human origin, confirmed from a cited original record.",
      "properties": {
        "expert": {
          "anyOf": [
            {
              "$ref": "#/$defs/GoldHuman"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "annotated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Annotated At"
        },
        "basis": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Basis",
          "type": "string"
        },
        "unknown_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unknown Reason"
        }
      },
      "required": [
        "basis"
      ],
      "title": "GoldOriginalExpert",
      "type": "object"
    },
    "GoldPaper": {
      "additionalProperties": false,
      "properties": {
        "paper_key": {
          "minLength": 1,
          "title": "Paper Key",
          "type": "string"
        },
        "arxiv_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Arxiv Id"
        },
        "version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "paper_key",
        "arxiv_id"
      ],
      "title": "GoldPaper",
      "type": "object"
    },
    "GoldPdfFile": {
      "additionalProperties": false,
      "description": "一份固定 PDF 材料；哈希未核定时保持待补，不虚构。",
      "properties": {
        "file_id": {
          "minLength": 1,
          "title": "File Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "file_id",
        "name"
      ],
      "title": "GoldPdfFile",
      "type": "object"
    },
    "GoldPendingItem": {
      "additionalProperties": false,
      "description": "草稿显式记录的未解决事项；正式答案不得携带。",
      "properties": {
        "item_id": {
          "minLength": 1,
          "title": "Item Id",
          "type": "string"
        },
        "category": {
          "enum": [
            "missing_info",
            "science_review",
            "structural_gap"
          ],
          "title": "Category",
          "type": "string"
        },
        "subject": {
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "category",
        "subject",
        "description"
      ],
      "title": "GoldPendingItem",
      "type": "object"
    },
    "GoldPreparationAuthor": {
      "additionalProperties": false,
      "description": "Who prepared this particular draft or revision, and why.",
      "properties": {
        "actor": {
          "$ref": "#/$defs/GoldActor"
        },
        "prepared_at": {
          "format": "date-time",
          "title": "Prepared At",
          "type": "string"
        },
        "action": {
          "enum": [
            "initial_draft",
            "migration",
            "revision"
          ],
          "title": "Action",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "actor",
        "prepared_at",
        "action",
        "description"
      ],
      "title": "GoldPreparationAuthor",
      "type": "object"
    },
    "GoldProbability": {
      "additionalProperties": false,
      "description": "显式印出的覆盖概率或分位点；换算由消费方负责，不写回记录。",
      "properties": {
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "unit": {
          "enum": [
            "fraction",
            "%"
          ],
          "title": "Unit",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/GoldEvidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "value",
        "unit",
        "evidence"
      ],
      "title": "GoldProbability",
      "type": "object"
    },
    "GoldProvenance": {
      "additionalProperties": false,
      "properties": {
        "origin": {
          "enum": [
            "migration",
            "new_annotation"
          ],
          "title": "Origin",
          "type": "string"
        },
        "legacy": {
          "anyOf": [
            {
              "$ref": "#/$defs/GoldLegacySource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "original_expert": {
          "anyOf": [
            {
              "$ref": "#/$defs/GoldOriginalExpert"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "original_approval_version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Approval Version"
        },
        "prepared_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/GoldPreparationAuthor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "origin"
      ],
      "title": "GoldProvenance",
      "type": "object"
    },
    "GoldQuantityGroup": {
      "additionalProperties": false,
      "properties": {
        "quantity": {
          "minLength": 1,
          "title": "Quantity",
          "type": "string"
        },
        "values": {
          "items": {
            "$ref": "#/$defs/GoldValue"
          },
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "quantity",
        "values"
      ],
      "title": "GoldQuantityGroup",
      "type": "object"
    },
    "GoldRulesRef": {
      "additionalProperties": false,
      "description": "标注所依据的科学规则版本；旧规则版本不能替代。",
      "properties": {
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "version",
        "sha256"
      ],
      "title": "GoldRulesRef",
      "type": "object"
    },
    "GoldSchemaTag": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "GoldSchemaTag",
      "type": "object"
    },
    "GoldValue": {
      "additionalProperties": false,
      "description": "一组科学数值的 Gold 保存形式；未提供的内容为 null，草稿允许空证据。\n\n误差形式复用共同记录 ``MeasuredValue`` 的当前规则：单侧非对称误差\n允许，总误差可与具名分量并存（各有独立依据），仅对称与非对称不能\n混用；空字符串一律用 null 表示未提供。",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error"
        },
        "lower_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lower Error"
        },
        "upper_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Upper Error"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        },
        "limit_kind": {
          "default": "none",
          "enum": [
            "none",
            "lower_limit",
            "upper_limit",
            "range"
          ],
          "title": "Limit Kind",
          "type": "string"
        },
        "range_lower": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
