      "value": "follow_up",
      "evidence": [
        {
          "location": "T:p12-b3",
          "quote": "In this section we assess the performance of Gaia in measuring\nthe astrometric properties of the current observed sample of HVS\ncandidates. Brown et al. (2015) measured proper motions with the\nHubble Space Telescope (HST) for 16 extreme radial velocity can-\ndidates, finding that 13 of them have trajectories consistent with a\nGC origin within 2σ confidence levels, and 12 of them are unbound\nto the Milky Way."
        },
        {
          "location": "I:p14-b0"
        }
      ],
      "source": "1711.11397v2"
    },
    {
      "value": "follow_up",
      "evidence": [
        {
          "location": "T:p1-b8",
          "quote": "We reanalyzed low-resolution optical spectra of 14 HVSs from the MMT HVS survey"
        },
        {
          "location": "T:p1-b16",
          "quote": "The MMT HVS survey by Brown et al. (2014) discovered 38\nlate B-type HVSs, 16 of which are considered to be bound to the\nGalaxy. We selected the 14 most interesting ones, that is, those\nstars which have proper motions measured by HST."
        }
      ],
      "source": "1806.08630v1"
    },
    {
      "value": "follow_up",
      "evidence": [
        {
          "location": "T:p1-b10",
          "quote": "what is commonly called a hypervelocity star\n(HVS), that is, a star moving faster than its local Galactic escape\nvelocity"
        },
        {
          "location": "T:p1-b10",
          "quote": "late B-type stars that qualified as candidate HVSs"
        },
        {
          "location": "T:p2-b8",
          "quote": "14 stars from the MMT-HVS survey and for PG 1610+062"
        }
      ],
      "source": "2101.10878v1"
    }
