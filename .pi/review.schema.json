{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "findings", "validation", "risks"],
  "properties": {
    "verdict": { "type": "string", "enum": ["pass", "changes_required", "blocked"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "file", "issue", "fix"],
        "properties": {
          "severity": { "type": "string", "enum": ["must_fix", "optional"], "description": "Reviewer recommendation; the parent decides which findings merit repair." },
          "file": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "issue": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "fix": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    },
    "validation": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "risks": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 1000 } }
  }
}
