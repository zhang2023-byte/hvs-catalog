{
  "skills": [
    "~/.agents/skills",
    "~/.pi/agent/skills",
    "!**"
  ],
  "prompts": [
    "~/.pi/agent/prompts",
    "!**",
    "+prompts/hvs-work.md"
  ],
  "packages": [
    {
      "source": "npm:pi-web-access@0.33.0",
      "autoload": false,
      "extensions": [
        "!**",
        "+dist/index.js"
      ],
      "skills": [
        "!**"
      ],
      "prompts": [
        "!**"
      ],
      "themes": [
        "!**"
      ]
    },
    {
      "source": "npm:pi-subagents@0.73.1",
      "autoload": false,
      "extensions": [
        "!**",
        "+index.js"
      ],
      "skills": [
        "!**"
      ],
      "prompts": [
        "!**"
      ],
      "themes": [
        "!**"
      ]
    }
  ],
  "compaction": {
    "enabled": true,
    "reserveTokens": 32768,
    "keepRecentTokens": 20000,
    "modelOverrides": {
      "zai-coding-cn/glm-5.3": {
        "reserveTokens": 700000
      }
    }
  },
  "retry": {
    "enabled": true,
    "maxRetries": 2,
    "baseDelayMs": 2000,
    "maxAgentDelayMs": 30000,
    "provider": {
      "maxRetries": 0
    }
  },
  "subagents": {
    "projectRootResolution": "git-root",
    "disableBuiltins": true,
    "defaultExtensions": [],
    "modelScope": {
      "enforce": true,
      "strict": true,
      "allow": [
        "zai-coding-cn/glm-5.3",
        "openai-codex/gpt-6.1-sol"
      ]
    },
    "watchdog": {
      "enabled": false,
      "children": {
        "enabled": false
      }
    }
  }
}
