{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-astra",
  "defaultThinkingLevel": "high",
  "enabledModels": [
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6-sol",
    "zai-coding-cn/glm-5.3"
  ],
  "skills": [
    "~/.agents/skills",
    "~/.pi/agent/skills",
    "!**"
  ],
  "prompts": [
    "~/.pi/agent/prompts",
    "!**",
    "+prompts/hvs-work.md"
  ],
  "packages": [
    {
      "source": "npm:pi-web-access@0.31.0",
      "autoload": false,
      "extensions": [
        "!**",
        "+dist/index.js"
      ],
      "skills": [
        "!**"
      ],
      "prompts": [
        "!**"
      ],
      "themes": [
        "!**"
      ]
    },
    {
      "source": "npm:pi-subagents@0.71.0",
      "autoload": false,
      "extensions": [
        "!**",
        "+index.js"
      ],
      "skills": [
        "!**",
        "+skills/pi-subagents/SKILL.md"
      ],
      "prompts": [
        "!**"
      ],
      "themes": [
        "!**"
      ]
    }
  ],
  "compaction": {
    "enabled": true,
    "reserveTokens": 32768,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 2,
    "baseDelayMs": 2000,
    "maxAgentDelayMs": 30000,
    "provider": {
      "maxRetries": 0
    }
  },
  "subagents": {
    "projectRootResolution": "git-root",
    "disableBuiltins": true,
    "defaultExtensions": [],
    "modelScope": {
      "enforce": true,
      "strict": true,
      "allow": [
        "zai-coding-cn/glm-5.3",
        "openai-codex/gpt-6-sol"
      ]
    },
    "watchdog": {
      "enabled": false,
      "children": {
        "enabled": false
      }
    }
  }
}
