{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-astra",
  "defaultThinkingLevel": "high",
  "enabledModels": [
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6-sol",
    "zai-coding-cn/glm-5.3"
  ],
  "skills": ["~/.agents/skills", "~/.pi/agent/skills", "!**"],
  "prompts": ["~/.pi/agent/prompts", "!**", "+prompts/hvs-work.md"],
  "packages": [
    {
      "source": "npm:pi-subagents",
      "autoload": false,
      "prompts": ["!**"]
    },
    {
      "source": "npm:@narumitw/pi-btw",
      "autoload": false,
      "extensions": ["!**"],
      "skills": ["!**"],
      "prompts": ["!**"]
    },
    {
      "source": "npm:@plannotator/pi-extension",
      "autoload": false,
      "extensions": ["!**"],
      "skills": ["!**"],
      "prompts": ["!**"]
    }
  ],
  "compaction": {
    "enabled": true,
    "reserveTokens": 32768,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 2,
    "baseDelayMs": 2000,
    "maxAgentDelayMs": 30000,
    "provider": { "maxRetries": 0 }
  },
  "subagents": {
    "projectRootResolution": "git-root",
    "disableBuiltins": true,
    "defaultExtensions": [],
    "modelScope": {
      "enforce": true,
      "strict": true,
      "allow": ["zai-coding-cn/glm-5.3", "openai-codex/gpt-6-sol"]
    },
    "watchdog": { "enabled": false, "children": { "enabled": false } }
  }
}
